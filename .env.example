# --- Provider: Baseten Model APIs (the headline provider) ---------------
# OpenAI Chat Completions-compatible. Set the key and pick a live
# profile to run the agent on an open model served by Baseten. A live
# profile selected without the key refuses at startup, by name.
BASETEN_API_KEY=
BASETEN_BASE_URL=https://inference.baseten.co/v1
# Optional slug pin, in org/name form. It is validated against the
# SELECTED profile's own allowlist (profiles/*.json): pinning another
# family's slug here is refused — select that family's profile.
BASETEN_MODEL=zai-org/GLM-5

# Which model profile the agent runs (records in profiles/*.json):
#   offline         — the labelled scripted stand-in (default; tests/demo)
#   baseten-glm     — zai-org/GLM-5          baseten-kimi — moonshotai/Kimi-K2.5
#   baseten-deepseek — deepseek-ai/DeepSeek-V3.1
#   baseten-qwen    — Qwen/Qwen3-Coder-480B-A35B-Instruct
#   baseten-gpt-oss — openai/gpt-oss-120b
MODEL_PROFILE=offline

# --- Store ---------------------------------------------------------------
# SQLite is the local default; set DATABASE_URL for the Postgres profile.
SQLITE_PATH=./data/codingagent.db
# DATABASE_URL=postgresql://codingagent@db:5432/codingagent

# --- Policy ---------------------------------------------------------------
# Per-run step ceiling for the agent loop.
CODINGAGENT_MAX_STEPS=40
# Wall-clock ceiling (seconds) for one allowlisted test invocation.
CODINGAGENT_TEST_TIMEOUT=120
