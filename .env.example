# --- Provider: Baseten Model APIs (the headline provider) ---------------
# OpenAI Chat Completions-compatible. Set the key and pick a live
# profile to run the agent on an open model served by Baseten. A live
# profile selected without the key refuses at startup, by name.
BASETEN_API_KEY=
BASETEN_BASE_URL=https://inference.baseten.co/v1
# Optional slug pin, in org/name form. It is validated against the
# SELECTED profile's own allowlist (profiles/*.json): pinning another
# family's slug here is refused — select that family's profile.
BASETEN_MODEL=zai-org/GLM-5.2

# Which model profile the agent runs (records in profiles/*.json;
# slugs verified against Baseten's live Model APIs catalog,
# 2026-10-19):
#   offline         — the labelled scripted stand-in (default; tests/demo)
#   baseten-deepseek — deepseek-ai/DeepSeek-V4-Flash-0731
#   baseten-glm     — zai-org/GLM-5.2        baseten-kimi — moonshotai/Kimi-K3
#   baseten-gpt-oss — openai/gpt-oss-120b
#   baseten-qwen    — Qwen/Qwen3-Coder-480B-A35B-Instruct — recorded
#                     NOT SERVABLE: the current catalog lists no Qwen
#                     model; selecting it refuses with that reason.
MODEL_PROFILE=offline

# --- Deployment profile (round 16) ---------------------------------------
# The deployment's shape, as a governed record (profiles/deployment/).
# Naming a profile binds its rules at startup: a configuration that
# violates a rule of the profile it names refuses before anything
# serves, naming the profile and the rule.
#   local       — the developer default: offline or live model,
#                 SQLite or Postgres, no key beyond the model
#                 profile's own rule.
#   hosted      — production on Baseten's Model APIs: a live model
#                 profile must serve, DATABASE_URL (Postgres) is
#                 required, and the profile's key must be present.
#   hosted-self — production on a self-hosted endpoint: like hosted,
#                 and BASETEN_BASE_URL must point at a host that is
#                 not a Baseten host.
DEPLOYMENT_PROFILE=local

# --- Store ---------------------------------------------------------------
# SQLite is the local default; set DATABASE_URL for the Postgres profile.
SQLITE_PATH=./data/codingagent.db
# DATABASE_URL=postgresql://codingagent@db:5432/codingagent

# --- Policy ---------------------------------------------------------------
# Per-run step ceiling for the agent loop.
CODINGAGENT_MAX_STEPS=40
# Wall-clock ceiling (seconds) for one allowlisted test invocation.
CODINGAGENT_TEST_TIMEOUT=120
# Per-run budget ceilings, enforced in the shell (round 6). A run
# snapshots them at start; crossing one stops the run INTERRUPTED
# with the ceiling named. A budget-stopped run cannot resume —
# restart spends a fresh budget.
CODINGAGENT_MAX_MODEL_CALLS=200
CODINGAGENT_MAX_TOKENS=2000000
# Active seconds (time spent interrupted, waiting, does not count).
CODINGAGENT_MAX_WALL_SECONDS=1800

# --- Prices ---------------------------------------------------------------
# The governed price table lives in prices/ as versioned records
# (table-v<N>.json), loaded fail-closed. Point this elsewhere only
# to use a deployment's own recorded table.
# PRICES_DIR=/path/to/prices

# --- Taxonomy ---------------------------------------------------------------
# The failure taxonomy lives in taxonomy/ as a versioned record
# (taxonomy-v<N>.json), loaded fail-closed. Point this elsewhere
# only to use a deployment's own recorded taxonomy.
# TAXONOMY_DIR=/path/to/taxonomy

# --- Release gate (tests only; never a deployment setting) ------------------
# The Postgres conformance leg (tests/test_postgres_conformance.py)
# runs only when this names a SCRATCH database — one with "test"
# in its name. The leg wipes that database's blueprint tables
# before each test and refuses, loudly, if the name does not look
# like a test database or the DSN names the same database as
# DATABASE_URL. Leave unset and the leg skips.
# CODINGAGENT_TEST_DATABASE_URL=postgresql://codingagent:codingagent@localhost:5432/codingagent_test

# --- Skills ---------------------------------------------------------------
# The skills library lives in skills/ as governed files — one
# content file per version plus the index that vouches for each
# version's content hash — loaded fail-closed. Point this
# elsewhere only to use a deployment's own library.
# SKILLS_DIR=/path/to/skills
